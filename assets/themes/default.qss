/* Dentiva Pro — default (light clinical) theme.
 * Tokens are substituted at runtime by theme.py so this file uses placeholders.
 * We use $TOKEN_NAME; the loader replaces them with actual hex/radii values.
 */

* {
    font-family: "$FONT_FAMILY_UI";
    font-size: $FONT_BASE;
    color: $TEXT_PRIMARY;
    outline: none;
}

QWidget {
    background-color: $BG_PAGE;
}

/* ---------- Header ---------- */
#DpHeader {
    background-color: $BG_SURFACE;
    border-bottom: 1px solid $DIVIDER;
    min-height: $HEADER_HEIGHT;
    max-height: $HEADER_HEIGHT;
}
#DpBrandLabel {
    font-size: $FONT_XL2;
    font-weight: 600;
    color: $PRIMARY;
    padding: 0 $S4 0 $S2;
}
#DpClinicLabel {
    font-size: $FONT_SM;
    color: $TEXT_SECONDARY;
    padding: 0 $S4;
}
#DpDateLabel {
    font-size: $FONT_SM;
    color: $TEXT_SECONDARY;
    padding: 0 $S4;
}
#DpIconButton {
    background: transparent;
    border: none;
    border-radius: $RADIUS_CONTROL;
    padding: $S2 $S2;
    min-width: 32px;
    min-height: 32px;
}
#DpIconButton:hover { background-color: $BG_HOVER; }
#DpIconButton:pressed { background-color: $BG_SUBTLE; }

/* ---------- Sidebar ---------- */
#DpSidebar {
    background-color: $BG_SIDEBAR;
    border-right: none;
}
#DpSidebarScroll QScrollBar:vertical { width: 0; background: transparent; }
#DpNavSectionLabel {
    color: rgba(255,255,255,0.55);
    font-size: $FONT_XS;
    padding: $S4 $S4 $S1 $S4;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}
#DpNavButton {
    background: transparent;
    border: none;
    color: rgba(255,255,255,0.82);
    text-align: left;
    padding: $S2 $S4;
    margin: 1px $S2;
    border-radius: $RADIUS_CONTROL;
    min-height: 36px;
    font-size: $FONT_SM;
}
#DpNavButton:hover { background-color: $BG_SIDEBAR_HOVER; color: white; }
#DpNavButton:pressed { background-color: $BG_SIDEBAR_ACTIVE; }
#DpNavButton[active="true"] {
    background-color: $PRIMARY;
    color: white;
    font-weight: 600;
}
#DpNavButton[collapsed="true"] {
    padding: $S2;
    margin: 1px auto;
    min-width: 40px;
    max-width: 48px;
    text-align: center;
}

/* ---------- Content area ---------- */
#DpContentArea {
    background-color: $BG_PAGE;
    padding: $CONTENT_PAD;
}
#DpPageTitle {
    font-size: $FONT_XL2;
    font-weight: 600;
    color: $TEXT_PRIMARY;
    padding-bottom: $S2;
}
#DpPageSubtitle {
    font-size: $FONT_SM;
    color: $TEXT_SECONDARY;
    padding-bottom: $S4;
}

/* ---------- Cards ---------- */
#DpCard {
    background-color: $BG_SURFACE;
    border: 1px solid $DIVIDER;
    border-radius: $RADIUS_CARD;
    padding: $S5;
}
#DpCardTitle {
    font-size: $FONT_LG;
    font-weight: 600;
    color: $TEXT_PRIMARY;
    padding-bottom: $S3;
}

/* ---------- Buttons ---------- */
QPushButton {
    background-color: $BG_SURFACE;
    border: 1px solid $BORDER;
    border-radius: $RADIUS_CONTROL;
    padding: $S2 $S4;
    min-height: 30px;
    color: $TEXT_PRIMARY;
}
QPushButton:hover { background-color: $BG_HOVER; border-color: $BORDER_STRONG; }
QPushButton:pressed { background-color: $BG_SUBTLE; }
QPushButton:disabled { color: $TEXT_MUTED; background: $BG_SUBTLE; border-color: $DIVIDER; }

QPushButton[variant="primary"] {
    background-color: $PRIMARY;
    color: white;
    border: 1px solid $PRIMARY;
    font-weight: 600;
}
QPushButton[variant="primary"]:hover { background-color: $PRIMARY_HOVER; border-color: $PRIMARY_HOVER; }
QPushButton[variant="primary"]:pressed { background-color: $PRIMARY_ACTIVE; }
QPushButton[variant="primary"]:disabled { background-color: $BORDER_STRONG; border-color: $BORDER_STRONG; color: rgba(255,255,255,0.7); }

QPushButton[variant="ghost"] {
    background: transparent; border-color: transparent; color: $TEXT_LINK;
}
QPushButton[variant="ghost"]:hover { background-color: $INFO_BG; }

QPushButton[variant="destructive"] {
    background-color: $ERROR; color: white; border-color: $ERROR;
}
QPushButton[variant="destructive"]:hover { background-color: #D92D20; border-color: #D92D20; }

/* ---------- Form inputs ---------- */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QDateEdit, QComboBox {
    background-color: $BG_SURFACE;
    border: 1px solid $BORDER;
    border-radius: $RADIUS_CONTROL;
    padding: $S1 $S2;
    min-height: 28px;
    selection-background-color: $PRIMARY;
    selection-color: white;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QDateEdit:focus, QComboBox:focus {
    border: 2px solid $PRIMARY;
    padding: $S1 - 0 $S2 - 0;
}
QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled, QSpinBox:disabled,
QDoubleSpinBox:disabled, QDateEdit:disabled, QComboBox:disabled {
    background-color: $BG_SUBTLE; color: $TEXT_MUTED;
}
QComboBox::drop-down { border: none; width: 24px; }
QComboBox QAbstractItemView {
    background: $BG_SURFACE; border: 1px solid $BORDER; selection-background-color: $PRIMARY; selection-color: white;
}

QLabel { background: transparent; }
#DpFieldLabel {
    font-size: $FONT_SM;
    color: $TEXT_SECONDARY;
    padding-bottom: $S1;
    font-weight: 600;
}
#DpFieldHint {
    font-size: $FONT_XS;
    color: $TEXT_TERTIARY;
    padding-top: $S1;
}
#DpFieldError {
    font-size: $FONT_XS;
    color: $ERROR;
    padding-top: $S1;
}

/* ---------- Tables ---------- */
QTableView, QTreeView {
    background-color: $BG_SURFACE;
    border: 1px solid $DIVIDER;
    border-radius: $RADIUS_CARD;
    gridline-color: $DIVIDER;
    selection-background-color: $INFO_BG;
    selection-color: $TEXT_PRIMARY;
    alternate-background-color: $BG_HOVER;
}
QHeaderView::section {
    background-color: $BG_SURFACE;
    border: none;
    border-bottom: 1px solid $DIVIDER;
    padding: $S2 $S3;
    font-weight: 600;
    color: $TEXT_SECONDARY;
    font-size: $FONT_SM;
}
QTableView::item, QTreeView::item {
    padding: $S2 $S3;
    border: none;
    border-bottom: 1px solid $DIVIDER;
    min-height: 28px;
}
QTableView::item:selected, QTreeView::item:selected {
    background-color: $INFO_BG;
    color: $TEXT_PRIMARY;
}

/* ---------- Tabs ---------- */
QTabWidget::pane {
    border: 1px solid $DIVIDER;
    border-radius: $RADIUS_CARD;
    background: $BG_SURFACE;
    top: -1px;
}
QTabBar::tab {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    padding: $S2 $S4;
    min-height: 32px;
    margin-right: $S4;
    color: $TEXT_SECONDARY;
}
QTabBar::tab:hover { color: $TEXT_PRIMARY; }
QTabBar::tab:selected { color: $PRIMARY; border-bottom: 2px solid $PRIMARY; font-weight: 600; }

/* ---------- Stat tiles (dashboard) ---------- */
#DpStatTile {
    background-color: $BG_SURFACE;
    border: 1px solid $DIVIDER;
    border-radius: $RADIUS_CARD;
    padding: $S5;
    min-height: 96px;
}
#DpStatValue {
    font-size: $FONT_XL3;
    font-weight: 700;
    color: $TEXT_PRIMARY;
}
#DpStatLabel {
    font-size: $FONT_SM;
    color: $TEXT_SECONDARY;
    padding-top: $S1;
}

/* ---------- Dialogs/Modals ---------- */
#DpDialog {
    background-color: $BG_SURFACE;
    border: 1px solid $DIVIDER;
    border-radius: $RADIUS_DIALOG;
}
#DpDialogTitle {
    font-size: $FONT_LG; font-weight: 600; color: $TEXT_PRIMARY; padding-bottom: $S2;
}
#DpDialogBody { background: transparent; }
#DpDialogButtons { background: transparent; padding-top: $S4; }

/* ---------- Empty state ---------- */
#DpEmptyState { background: transparent; padding: $S12; }
#DpEmptyStateTitle { font-size: $FONT_LG; font-weight: 600; color: $TEXT_PRIMARY; }
#DpEmptyStateText { color: $TEXT_SECONDARY; font-size: $FONT_SM; padding: $S2 0 $S4 0; }

/* ---------- Toasts ---------- */
#DpToast {
    background-color: $TEXT_PRIMARY;
    color: white;
    border-radius: $RADIUS_CARD;
    padding: $S3 $S4;
    font-size: $FONT_SM;
}
#DpToast[kind="success"] { background-color: $SUCCESS; }
#DpToast[kind="warning"] { background-color: $WARNING; color: $TEXT_PRIMARY; }
#DpToast[kind="error"]   { background-color: $ERROR; }
#DpToast[kind="info"]    { background-color: $INFO; }

/* ---------- Scrollbars ---------- */
QScrollBar:vertical {
    background: transparent; width: 10px; margin: 0;
}
QScrollBar::handle:vertical {
    background: $BORDER; border-radius: 4px; min-height: 30px;
}
QScrollBar::handle:vertical:hover { background: $BORDER_STRONG; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal {
    background: transparent; height: 10px; margin: 0;
}
QScrollBar::handle:horizontal {
    background: $BORDER; border-radius: 4px; min-width: 30px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ---------- Misc ---------- */
QStatusBar { background-color: $BG_SURFACE; border-top: 1px solid $DIVIDER; color: $TEXT_TERTIARY; }
QToolTip {
    background-color: $TEXT_PRIMARY; color: white; border: none; padding: $S1 $S2; border-radius: $RADIUS_SMALL;
}
QMenuBar { background-color: $BG_SURFACE; border-bottom: 1px solid $DIVIDER; }
QMenuBar::item:selected { background-color: $BG_HOVER; }
QMenu { background-color: $BG_SURFACE; border: 1px solid $DIVIDER; padding: $S1; }
QMenu::item { padding: $S2 $S6; border-radius: $RADIUS_SMALL; }
QMenu::item:selected { background-color: $PRIMARY; color: white; }
QMenu::separator { height: 1px; background: $DIVIDER; margin: $S1 $S2; }
QGroupBox {
    border: 1px solid $DIVIDER; border-radius: $RADIUS_CARD; margin-top: $S5; padding: $S4; font-weight: 600;
}
QGroupBox::title { subcontrol-origin: margin; left: $S3; padding: 0 $S1; color: $TEXT_SECONDARY; }

QCheckBox, QRadioButton { spacing: $S2; min-height: 24px; }
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px; height: 16px; border: 1px solid $BORDER; border-radius: $RADIUS_SMALL; background: white;
}
QRadioButton::indicator { border-radius: 8px; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: $PRIMARY; border-color: $PRIMARY;
}

/* ---------- Popups (global search + notifications) ---------- */
#DpSearchPopup, #DpNotifPopup {
    background-color: $BG_SURFACE;
    border: 1px solid $DIVIDER;
    border-radius: $RADIUS_CARD;
}
#DpSearchInput {
    padding: $S2 $S3;
    border: 1px solid $BORDER;
    border-radius: $RADIUS_CONTROL;
    background: $BG_SURFACE;
    color: $TEXT_PRIMARY;
    font-size: $FONT_BASE;
}
#DpSearchInput:focus { border-color: $PRIMARY; }
#DpSearchHint { color: $TEXT_MUTED; font-size: $FONT_SM; }
#DpSearchResults, #DpNotifList, #DpUpcomingList, #DpAlertsList {
    border: none;
    background: $BG_SURFACE;
    font-size: $FONT_SM;
    padding: $S1;
    border-radius: $RADIUS_SMALL;
}
#DpSearchResults::item, #DpNotifList::item, #DpUpcomingList::item, #DpAlertsList::item {
    padding: $S2 $S2;
    border-radius: $RADIUS_SMALL;
    color: $TEXT_PRIMARY;
}
#DpSearchResults::item:selected, #DpNotifList::item:selected {
    background: $BG_SUBTLE;
    color: $TEXT_PRIMARY;
}
#DpPopupTitle { font-size: $FONT_BASE; font-weight: 600; color: $TEXT_PRIMARY; }

/* ---------- Data tables ---------- */
#DpDataTable {
    background-color: $BG_SURFACE;
    border: 1px solid $DIVIDER;
    border-radius: $RADIUS_CARD;
    gridline-color: $DIVIDER;
    selection-background-color: $PRIMARY;
    selection-color: white;
    font-size: $FONT_SM;
}
#DpDataTable::item {
    padding: $S2 $S3;
    border-bottom: 1px solid $DIVIDER;
}
#DpDataTable::item:selected {
    background-color: $PRIMARY;
    color: white;
}
QHeaderView::section {
    background-color: $BG_SUBTLE;
    color: $TEXT_SECONDARY;
    padding: $S2 $S3;
    border: none;
    border-right: 1px solid $DIVIDER;
    border-bottom: 1px solid $DIVIDER;
    font-weight: 600;
    font-size: $FONT_SM;
}
